# ==============================================================================
# ClassSync AI - .gitignore para Produção / Google Cloud
# ==============================================================================

# Bytecode e caches Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Ambientes virtuais
.venv/
venv/
ENV/
env/

# Testes e cobertura
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# Variáveis de ambiente e arquivos de credenciais/anotações
.env
.env.*
!.env.example
super-user.txt
github.txt

# Bancos de dados e volumes de dados locais (usar Cloud SQL / GCS em nuvem)
data/
db/*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Editores, IDEs e agentes de IA
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
.agents/
.antigravity/
.claude/

# Artefatos do Framework Reversa (não necessários em produção/deploy)
.reversa/
_reversa_sdd/
_reversa_docs/
_reversa_forward/
_reversa_bugs/
_reversa_refactor/

# Pastas clonadas ou temporárias
csalas/

