# ==============================================================================
# ClassSync AI - Configuração de Ambiente por Instância Institucional (Multi-Tenant)
# ==============================================================================

# Identificador Slug da Instituição (ex: faculdade_alpha, unip_sp, puc_rio)
TENANT_NAME=faculdade_alpha

# Porta TCP exposta no host para o container desta instituição
PORT=8001

# Endereço de escuta da aplicação
HOST=0.0.0.0

# Diretório no host para armazenamento dos volumes de dados persistentes do tenant
DATA_DIR=./data/faculdade_alpha

# String de conexão SQLAlchemy (SQLite em volume desacoplado ou PostgreSQL em nuvem)
# SQLite: sqlite:////app/data/classsync.db
# PostgreSQL: postgresql://user:password@db-host:5432/faculdade_alpha_db
DATABASE_URL=sqlite:////app/data/classsync.db

# Chave Criptográfica Secreta exclusiva para assinatura dos tokens JWT da instituição
# Em produção, gere uma chave pseudoaleatória segura (ex: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_64_hex_string_for_production

# Ambiente de execução (development | staging | production)
APP_ENV=production
